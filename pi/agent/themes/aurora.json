    "_l3":       "#17203a",
    "_sel":      "#1d2a4d",

    "_fg":       "#e9edf7",
    "_fgStrong": "#f7f9fe",
    "_muted":    "#98a2ba",
    "_dim":      "#5a6580",
    "_dimmer":   "#313c58",
    "_dimmest":  "#1a2237",

    "_cyan":       "#35e6ff",
    "_cyanBright": "#7ff2ff",
    "_cyanDeep":   "#0bb6d6",
    "_sky":        "#4aa8ff",
    "_indigo":     "#7c86ff",
    "_periwinkle": "#9a8dff",
    "_violet":     "#b98cff",
    "_magenta":    "#ff5db1",

    "_mint":     "#38efa6",
    "_amber":    "#ffb84d",
    "_rose":     "#ff5c78",

    "_okBg":     "#0c2018",
    "_errBg":    "#24101a"
