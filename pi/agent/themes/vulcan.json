{
  "$schema": "https://raw.githubusercontent.com/earendil-works/coding-agent/main/src/modes/interactive/theme/theme-schema.json",
  "name": "vulcan",

  "//": "Vulcan — the forge. Molten orange accent over iron-black layers tinted toward scorched umber. Companion theme to the vulcan chrome extension: its heat ramp (iron → ember → molten → gold → white-hot) is the same one the chrome uses for gauges and frames. Derived from ember.json but pushed hotter: orange core instead of amber, deep-red errors like cooling slag, pale gold for white-hot emphasis.",

  "vars": {
    "_layer0":      "#0d0b09",
    "_layer1":      "#14100c",
    "_layer2":      "#191410",
    "_layer3":      "#201913",
    "_layerSelect": "#2b2118",

    "_text":        "#ede4d6",
    "_textStrong":  "#f8f0df",
    "_muted":       "#a99a82",
    "_dim":         "#7b6e5c",
    "_dimmer":      "#3e352a",
    "_dimmest":     "#251e16",

    "_molten":      "#f97316",
    "_moltenHot":   "#fb923c",
    "_gold":        "#fbbf24",
    "_goldPale":    "#fde68a",
    "_emberDeep":   "#ea580c",
    "_emberDim":    "#9a3412",

    "_sage":        "#a3cf95",
    "_slag":        "#f87171",
    "_warn":        "#fcd34d",

    "_userTint":    "#171209",
    "_toolBg":      "#191410",
    "_toolOk":      "#1a2117",
    "_toolErr":     "#261715",

    "_kw":          "#fb923c",
    "_fn":          "#fde68a",
    "_str":         "#a3cf95",
    "_num":         "#f97316",
    "_type":        "#fcd34d",
    "_var":         "#ede4d6",
    "_op":          "#a99a82"
