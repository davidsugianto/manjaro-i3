    "mdQuote":          "_muted",
    "mdQuoteBorder":    "_emberDim",
    "mdHr":             "_dimmest",
    "mdListBullet":     "_molten",

    "toolDiffAdded":    "_sage",
    "toolDiffRemoved":  "_slag",
    "toolDiffContext":  "_dim",

    "syntaxComment":    "_dim",
    "syntaxKeyword":    "_kw",
    "syntaxFunction":   "_fn",
    "syntaxVariable":   "_var",
    "syntaxString":     "_str",
    "syntaxNumber":     "_num",
    "syntaxType":       "_type",
    "syntaxOperator":   "_op",
    "syntaxPunctuation":"_muted",

    "thinkingOff":      "_dimmest",
