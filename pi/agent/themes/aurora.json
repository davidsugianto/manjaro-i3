{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "aurora",

  "//": "Aurora — a futuristic AI command-deck palette. Neon cyan primary sweeping to violet, on a deep space-black canvas. Zero-chroma dark neutrals keep long sessions calm; the cyan→violet ramp (toolTitle→accent→mdLink→syntaxType→mdCode→customMessageLabel) is what aurora.ts uses for gradient wordmarks, rules, and meters. Body text aimed at ≥12:1 contrast.",

  "vars": {
