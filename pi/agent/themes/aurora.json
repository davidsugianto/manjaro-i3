    "customMessageBg":    "_l2",
    "customMessageText":  "_fg",
    "customMessageLabel": "_violet",

    "toolPendingBg":      "_l1",
    "toolSuccessBg":      "_okBg",
    "toolErrorBg":        "_errBg",
    "toolTitle":          "_cyanBright",
    "toolOutput":         "_muted",

    "mdHeading":          "_cyan",
    "mdLink":             "_sky",
    "mdLinkUrl":          "_dim",
    "mdCode":             "_periwinkle",
