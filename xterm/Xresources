! ~/.Xresources — X resources for xterm, plus shared X settings.
!
! Reload without logging out:   xrdb -merge ~/.Xresources
! (the i3 config does this automatically on reload)
!
! xterm is the fallback terminal here ($mod+Shift+Return) — the thing you
! reach for when WezTerm won't start. So it's configured to be genuinely
! usable rather than merely present.

! ---------------------------------------------------------------------------
! Catppuccin Mocha
!
! Defined once as named resources, then referenced below. Change these eleven
! lines to re-theme xterm; the backup palettes are at the bottom.
! ---------------------------------------------------------------------------

#define CM_BG      #1e1e2e
#define CM_BG_ALT  #181825
#define CM_FG      #cdd6f4
#define CM_FG_ALT  #bac2de
#define CM_MUTED   #6c7086
#define CM_ACCENT  #89b4fa
#define CM_URGENT  #f38ba8

*background:            CM_BG
*foreground:            CM_FG
*cursorColor:           CM_FG
*highlightColor:        #585b70
*colorUL:               CM_ACCENT
*colorBD:               CM_FG

! normal (0-7)
*color0:                #45475a
*color1:                #f38ba8
*color2:                #a6e3a1
*color3:                #f9e2af
*color4:                #89b4fa
*color5:                #f5c2e7
*color6:                #94e2d5
*color7:                #bac2de

! bright (8-15)
*color8:                #585b70
*color9:                #f38ba8
*color10:               #a6e3a1
*color11:               #f9e2af
*color12:               #89b4fa
*color13:               #cba6f7
*color14:               #94e2d5
*color15:               #a6adc8

! extended — peach and a deeper red, used by some TUIs
*color16:               #fab387
*color17:               #eba0ac

! ---------------------------------------------------------------------------
! xterm
! ---------------------------------------------------------------------------

XTerm*termName:                 xterm-256color
XTerm*locale:                   true
XTerm*utf8:                     2
XTerm*utf8Title:                true

! Font. The Nerd Font gives xterm the same glyph coverage as WezTerm, so
! prompts and TUIs do not fall apart in the fallback terminal.
XTerm*faceName:                 JetBrainsMono Nerd Font
XTerm*faceSize:                 10
XTerm*faceNameDoublesize:       Noto Color Emoji
XTerm*renderFont:               true
XTerm*forceBoxChars:            false

! Ctrl+plus / Ctrl+minus step through these.
XTerm*faceSize1:                8
XTerm*faceSize2:                9
XTerm*faceSize3:                11
XTerm*faceSize4:                13
XTerm*faceSize5:                16

XTerm*internalBorder:           8
XTerm*borderWidth:              0
XTerm*scrollBar:                false
XTerm*saveLines:                10000
XTerm*scrollTtyOutput:          false
XTerm*scrollKey:                true

XTerm*cursorBlink:              false
XTerm*cursorUnderLine:          false
XTerm*pointerColor:             CM_ACCENT
XTerm*pointerColorBackground:   CM_BG
! Hide the mouse pointer while typing.
XTerm*pointerMode:              2

XTerm*bellIsUrgent:             true
XTerm*visualBell:               false

! Treat these as word characters when double-clicking, so you can select a
! path or URL in one go instead of five.
XTerm*charClass:                33:48,35-38:48,39:43,42-47:48,58-59:48,61:48,63-64:48,95:48,126:48

! Let programs use the alternate screen (less, vim, htop restore your
! scrollback on exit).
XTerm*titeInhibit:              false

! Copy/paste that matches every other app: Ctrl+Shift+C / Ctrl+Shift+V.
XTerm*selectToClipboard:        true
XTerm*translations:             #override \n\
    Ctrl Shift <Key>C:          copy-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>V:          insert-selection(CLIPBOARD) \n\
    Ctrl <Key>minus:            smaller-vt-font() \n\
    Ctrl <Key>plus:             larger-vt-font() \n\
    Ctrl <Key>0:                set-vt-font(d) \n\
    Shift <Key>Prior:           scroll-back(1,halfpage) \n\
    Shift <Key>Next:            scroll-forw(1,halfpage)

! Run as a login shell so ~/.zprofile and friends are sourced.
XTerm*loginShell:               true
XTerm*metaSendsEscape:          true
XTerm*eightBitInput:            false

! ---------------------------------------------------------------------------
! other X resources
! ---------------------------------------------------------------------------

! DPI. This panel is 1366x768 at 14in, about 112 DPI, but 96 keeps GTK and Qt
! sizing consistent with the polybar/rofi pixel values in this repo. Raise it
! to 120 or 144 only if you move to a HiDPI screen.
Xft.dpi:                        96
Xft.antialias:                  true
Xft.hinting:                    true
Xft.hintstyle:                  hintslight
Xft.rgba:                       rgb
Xft.lcdfilter:                  lcddefault
Xft.autohint:                   false

! ---------------------------------------------------------------------------
! Mouse cursor
!
! This is what WezTerm reads on X11 (along with $XCURSOR_THEME). Without it,
! WezTerm and other raw-X clients fall back to the ancient default X11 bitmap
! cursor — the chunky black-and-white arrow that looks nothing like the
! pointer in GTK apps.
!
! The theme name must be a directory under /usr/share/icons or ~/.icons that
! contains a cursors/ subdirectory. The stock Manjaro config here pointed at
! "xcursor-breeze", which is not a package that exists — check with:
!     ls /usr/share/icons | while read t; do
!         test -d "/usr/share/icons/$t/cursors" && echo "$t"; done
! (a literal slash-star would start a C comment here — cpp processes
!  this file, so avoid that sequence even inside "!" comments.)
Xcursor.theme:                  breeze-cursors
Xcursor.size:                   24

! i3lock / xscreensaver-style dialogs pick these up.
*Dialog*background:             CM_BG
*Dialog*foreground:             CM_FG

