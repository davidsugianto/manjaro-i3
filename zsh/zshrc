# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ~/.zshrc
#
# Framework-free. Everything below is either builtin zsh or one of the plugin
# packages already in the Manjaro repos, sourced directly from /usr/share.
# That keeps startup under ~50ms and means a `pacman -Syu` never leaves you
# with a half-broken shell the way a vendored framework can.
#
# Layout:
#   1. environment   2. history   3. options   4. completion
#   5. keybindings   6. plugins   7. prompt    8. aliases & functions
#
# Machine-local overrides go in ~/.zshrc.local (git-ignored, sourced last).

# Skip everything for non-interactive shells (scp, rsync, git over ssh).
[[ $- != *i* ]] && return

# ---------------------------------------------------------------------------
# 1. environment
# ---------------------------------------------------------------------------

export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export BROWSER=google-chrome-stable
export TERMINAL=wezterm

# XDG base directories — keeps $HOME from filling up with dotfiles.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# -R passes through colour, -F skips the pager for short output, -X keeps
# output on screen after quitting.
export LESS='-R -F -X -i -M -j.5'
export LESSHISTFILE="$XDG_STATE_HOME/less_history"

# Colourise man pages using the terminal palette.
export MANROFFOPT='-P -c'
export MANPAGER="sh -c 'col -bx | bat --language man --style plain'"

# ~/.local/bin holds the helper scripts from this repo (lock, volume, …).
typeset -U path PATH
path=(
    "$HOME/.local/bin"
    "$HOME/bin"
    "$HOME/.cargo/bin"
    "$HOME/go/bin"
    $path
)
export PATH

# ---------------------------------------------------------------------------
# 2. history
# ---------------------------------------------------------------------------

HISTFILE="$XDG_STATE_HOME/zsh/history"
HISTSIZE=100000
SAVEHIST=100000
mkdir -p "${HISTFILE:h}"

setopt EXTENDED_HISTORY          # record timestamp and duration
setopt INC_APPEND_HISTORY        # write as you go, not just on exit
setopt SHARE_HISTORY             # new shells pick up other shells' history
setopt HIST_IGNORE_DUPS          # don't record an immediately repeated command
setopt HIST_IGNORE_ALL_DUPS      # and drop older duplicates entirely
setopt HIST_IGNORE_SPACE         # a leading space keeps it out of history
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY               # expand !! but let you confirm before running
setopt HIST_SAVE_NO_DUPS

# ---------------------------------------------------------------------------
# 3. options
# ---------------------------------------------------------------------------

setopt AUTO_CD                   # `..` and bare directory names cd
setopt AUTO_PUSHD                # every cd pushes onto the stack
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt CDABLE_VARS

setopt EXTENDED_GLOB             # ^, ~, # in globs
setopt GLOB_DOTS                 # * matches dotfiles too
setopt NUMERIC_GLOB_SORT
setopt NO_CASE_GLOB

setopt INTERACTIVE_COMMENTS      # # comments on the command line
setopt LONG_LIST_JOBS
setopt NOTIFY                    # report finished background jobs immediately
setopt NO_BEEP
setopt NO_FLOW_CONTROL           # frees Ctrl+S / Ctrl+Q
setopt PROMPT_SUBST

setopt CORRECT                   # offer to fix mistyped commands
unsetopt CORRECT_ALL             # …but not every argument, which is maddening

# Don't nuke a file with > if it exists; >| forces it.
setopt NO_CLOBBER

# ---------------------------------------------------------------------------
# 4. completion
# ---------------------------------------------------------------------------

# Completion functions generated by zsh/completions.zsh (kubectl, helm, gh, …)
# live here. This MUST come before compinit — compinit scans $fpath exactly
# once, so a directory added afterwards stays invisible until the next shell.
fpath=("${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions" $fpath)

# Only rebuild the dump once a day — `compinit` scanning $fpath is the single
# biggest cost in most zsh startups.
autoload -Uz compinit
_zcompdump="$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"
mkdir -p "${_zcompdump:h}"
if [[ -n ${_zcompdump}(#qN.mh+24) ]]; then
    compinit -d "$_zcompdump"
    # Compile it — sourcing the .zwc is measurably faster.
    { zcompile "$_zcompdump" } &!
else
    compinit -C -d "$_zcompdump"
fi
unset _zcompdump

zmodload -i zsh/complist

zstyle ':completion:*' menu select                       # arrow-key menu
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose true
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/zcompcache"
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' rehash true                       # notice new binaries

# Case-insensitive, then partial-word, then substring matching.
zstyle ':completion:*' matcher-list \
    'm:{a-zA-Z}={A-Za-z}' \
    'r:|[._-]=* r:|=*' \
    'l:|=* r:|=*'

zstyle ':completion:*:descriptions' format '%F{blue}── %d ──%f'
zstyle ':completion:*:warnings'     format '%F{red}no matches%f'
zstyle ':completion:*:messages'     format '%F{yellow}%d%f'

# Don't offer the current directory back to you after ../
zstyle ':completion:*' ignore-parents parent pwd
# Show a process list when completing kill.
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'

# ---------------------------------------------------------------------------
# 5. keybindings
# ---------------------------------------------------------------------------

bindkey -e   # emacs-style; swap to `bindkey -v` if you want modal editing

# Make Home/End/Delete/Ctrl+arrows behave the same in every terminal. The
# terminfo lookups cover WezTerm, kitty and xterm without hardcoding escapes.
typeset -A key=(
    Home     "${terminfo[khome]}"
    End      "${terminfo[kend]}"
    Insert   "${terminfo[kich1]}"
    Delete   "${terminfo[kdch1]}"
    Up       "${terminfo[kcuu1]}"
    Down     "${terminfo[kcud1]}"
    Left     "${terminfo[kcub1]}"
    Right    "${terminfo[kcuf1]}"
    PageUp   "${terminfo[kpp]}"
    PageDown "${terminfo[knp]}"
)
[[ -n ${key[Home]}   ]] && bindkey -- "${key[Home]}"   beginning-of-line
[[ -n ${key[End]}    ]] && bindkey -- "${key[End]}"    end-of-line
[[ -n ${key[Delete]} ]] && bindkey -- "${key[Delete]}" delete-char
[[ -n ${key[Insert]} ]] && bindkey -- "${key[Insert]}" overwrite-mode

bindkey '^[[1;5C' forward-word      # Ctrl+Right
bindkey '^[[1;5D' backward-word     # Ctrl+Left
bindkey '^H'      backward-kill-word
bindkey '^[[3;5~' kill-word         # Ctrl+Delete
bindkey '^U'      backward-kill-line
bindkey '^K'      kill-line

# Put the terminal into application mode while the line editor is active, so
# the terminfo codes above actually match what the terminal sends.
if (( ${+terminfo[smkx]} && ${+terminfo[rmkx]} )); then
    autoload -Uz add-zle-hook-widget
    function _zle_app_mode_start { echoti smkx }
    function _zle_app_mode_stop  { echoti rmkx }
    add-zle-hook-widget -Uz zle-line-init   _zle_app_mode_start
    add-zle-hook-widget -Uz zle-line-finish _zle_app_mode_stop
fi

# Edit the current command in $EDITOR with Ctrl+X Ctrl+E.
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# ---------------------------------------------------------------------------
# 6. plugins  (pacman packages, sourced straight from /usr/share)
# ---------------------------------------------------------------------------

ZSH_PLUGIN_DIR=/usr/share/zsh/plugins

# --- autosuggestions: ghost text from history -----------------------------
if [[ -r $ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c7086'   # Catppuccin Mocha overlay0 (comment colour)
    ZSH_AUTOSUGGEST_STRATEGY=(history completion)
    ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20             # don't suggest on huge lines
    source $ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh
    bindkey '^ '  autosuggest-accept               # Ctrl+Space accepts
    bindkey '^[[Z' autosuggest-accept              # Shift+Tab accepts
fi

# --- history substring search ---------------------------------------------
if [[ -r $ZSH_PLUGIN_DIR/zsh-history-substring-search/zsh-history-substring-search.zsh ]]; then
    source $ZSH_PLUGIN_DIR/zsh-history-substring-search/zsh-history-substring-search.zsh
    HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='bg=#585b70,fg=#89b4fa,bold'
    HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='bg=#f38ba8,fg=#1e1e2e,bold'
    HISTORY_SUBSTRING_SEARCH_FUZZY=1
    # Type a prefix, then Up/Down walks only matching history entries.
    [[ -n ${key[Up]}   ]] && bindkey -- "${key[Up]}"   history-substring-search-up
    [[ -n ${key[Down]} ]] && bindkey -- "${key[Down]}" history-substring-search-down
    bindkey '^P' history-substring-search-up
    bindkey '^N' history-substring-search-down
fi

# --- syntax highlighting --------------------------------------------------
# MUST be sourced last of the three — it wraps every widget defined before it.
if [[ -r $ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets pattern)
    typeset -A ZSH_HIGHLIGHT_STYLES
    ZSH_HIGHLIGHT_STYLES[command]='fg=#a6e3a1'
    ZSH_HIGHLIGHT_STYLES[builtin]='fg=#a6e3a1'
    ZSH_HIGHLIGHT_STYLES[function]='fg=#a6e3a1'
    ZSH_HIGHLIGHT_STYLES[alias]='fg=#a6e3a1'
    ZSH_HIGHLIGHT_STYLES[precommand]='fg=#a6e3a1,italic'
    ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#f38ba8,bold'
    ZSH_HIGHLIGHT_STYLES[path]='fg=#cdd6f4,underline'
    ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#f9e2af'
    ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#f9e2af'
    ZSH_HIGHLIGHT_STYLES[comment]='fg=#6c7086,italic'
    ZSH_HIGHLIGHT_STYLES[redirection]='fg=#cba6f7'
    ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#cba6f7'
    # Highlight `sudo rm -rf /` style footguns in red before you hit enter.
    ZSH_HIGHLIGHT_PATTERNS+=('rm -rf *' 'fg=#1e1e2e,bg=#f38ba8,bold')
    source $ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# --- fzf: Ctrl+R history, Ctrl+T files, Alt+C cd ---------------------------
if [[ -d /usr/share/fzf ]]; then
    source /usr/share/fzf/key-bindings.zsh 2>/dev/null
    source /usr/share/fzf/completion.zsh   2>/dev/null

    export FZF_DEFAULT_OPTS="
        --height 45% --layout=reverse --border=rounded --info=inline
        --color=bg+:#585b70,bg:#1e1e2e,spinner:#cba6f7,hl:#89b4fa
        --color=fg:#cdd6f4,header:#89b4fa,info:#f9e2af,pointer:#cba6f7
        --color=marker:#a6e3a1,fg+:#cdd6f4,prompt:#89b4fa,hl+:#89dceb
        --color=border:#313244"

    if command -v fd >/dev/null; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
    fi
    command -v bat >/dev/null && \
        export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
    export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window down:3:hidden:wrap --bind '?:toggle-preview'"
fi

# --- zoxide: `z <partial>` jumps to frecent directories --------------------
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# ---------------------------------------------------------------------------
# 7. prompt — powerlevel10k
#
# The p10k package is in the repos, so no git clone. Run `p10k configure` once
# to generate ~/.p10k.zsh; until then it uses its own sane defaults.
# ---------------------------------------------------------------------------

if [[ -r /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme ]]; then
    source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme
    [[ -r ~/.p10k.zsh ]] && source ~/.p10k.zsh
elif command -v starship >/dev/null; then
    eval "$(starship init zsh)"
else
    # Last-resort builtin prompt, still Catppuccin Mocha-coloured.
    autoload -Uz vcs_info
    zstyle ':vcs_info:git:*' formats ' %F{magenta}%b%f'
    precmd() { vcs_info }
    PROMPT='%F{blue}%~%f${vcs_info_msg_0_} %(?.%F{green}❯.%F{red}❯)%f '
fi

# ---------------------------------------------------------------------------
# 8. aliases & functions
# ---------------------------------------------------------------------------

[[ -r ${XDG_CONFIG_HOME}/zsh/aliases.zsh   ]] && source ${XDG_CONFIG_HOME}/zsh/aliases.zsh
[[ -r ${XDG_CONFIG_HOME}/zsh/functions.zsh ]] && source ${XDG_CONFIG_HOME}/zsh/functions.zsh

# Cloud/DevOps toolchain: completions, tool env (gvm, direnv, pyenv), and the
# kubectl/terraform/docker aliases. Sourced AFTER compinit because it uses
# `compdef`, which compinit defines — the matching fpath line is up in §4.
[[ -r ${XDG_CONFIG_HOME}/zsh/completions.zsh ]] && source ${XDG_CONFIG_HOME}/zsh/completions.zsh

# Machine-specific settings that shouldn't be committed.
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
export PATH="/home/maternal/.gvm/go/bin:$PATH"
export PATH="/home/maternal/.gvm/tools-bin:$PATH"

. "$HOME/.local/share/../bin/env"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/home/maternal/google-cloud-sdk/path.zsh.inc' ]; then . '/home/maternal/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/home/maternal/google-cloud-sdk/completion.zsh.inc' ]; then . '/home/maternal/google-cloud-sdk/completion.zsh.inc'; fi

# opencode
export PATH=/home/maternal/.opencode/bin:$PATH

# Pi
export PATH="/home/maternal/.local/share/pi-node/node-v22.23.2-linux-x64/bin:$PATH"
