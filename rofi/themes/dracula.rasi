/* Dracula — backup palette.
 * Same role names as colors.rasi; swap the @import in rofi/config.rasi.
 */

* {
    bg          : #282a36;
    bg-alt      : #21222c;
    bg-select   : #44475a;

    fg          : #f8f8f2;
    fg-alt      : #bd93f9;
    muted       : #6272a4;

    accent      : #bd93f9;
    accent-alt  : #ff79c6;

    ok          : #50fa7b;
    warn        : #f1fa8c;
    urgent      : #ff5555;


    /* rofi-theme(5): a reference cannot be a *subpart* of a property value,
     * so `highlight: bold @accent` is a syntax error. The whole composite has
     * to be defined here and referenced as a unit. */
    highlight-style : bold #bd93f9;

    background-color : transparent;
    text-color       : @fg;
}
