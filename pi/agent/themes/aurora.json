    "thinkingOff":        "_dimmest",
    "thinkingMinimal":    "_dimmer",
    "thinkingLow":        "_sky",
    "thinkingMedium":     "_cyan",
    "thinkingHigh":       "_violet",
    "thinkingXhigh":      "_magenta",

